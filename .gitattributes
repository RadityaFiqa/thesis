# Files that run on Linux must keep LF endings even when edited on Windows
* text=auto
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.xml       text eol=lf
*.py        text eol=lf
Caddyfile   text eol=lf
*.example   text eol=lf
*.template  text eol=lf
# Windows helpers
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.tar.gz    binary
