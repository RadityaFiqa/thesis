# Copied to .env by setup.sh, which fills every CHANGE_ME with a random value.
# Keep .env private (chmod 600). Never commit it.

NEXTCLOUD_DOMAIN=nextcloud.gbb-landu.my.id
WAZUH_DOMAIN=wazuh.gbb-landu.my.id

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Must match siem/config/wazuh_cluster/authd.pass (setup.sh writes both)
WAZUH_REGISTRATION_PASSWORD=CHANGE_ME
WAZUH_AGENT_NAME=nextcloud-host

# Fixed network so the proxy address can be trusted precisely
NC_SUBNET=172.30.10.0/24
CADDY_IP=172.30.10.10

# TLS between Cloudflare and this server. Set Cloudflare SSL/TLS mode to match:
#   internal                                              -> Cloudflare "Full"   (self-signed origin cert, works immediately)
#   /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem -> Cloudflare "Full (strict)" (Cloudflare Origin CA cert in caddy/certs/)
CADDY_TLS=internal

# Who may open the Wazuh dashboard (space-separated CIDRs, matched on the real client IP)
WAZUH_ALLOWED_CIDRS=0.0.0.0/0 ::/0
# Dashboard as published by the SIEM project on the host bridge address
WAZUH_DASHBOARD_UPSTREAM=host.docker.internal:5601

# Host ports for the proxy. Keep 80/443 on the VPS. The local test uses 8080/8443
# and sets PUBLIC_PORT_SUFFIX=:8443 so Nextcloud builds correct URLs.
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_PORT_SUFFIX=
