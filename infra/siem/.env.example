# Copied to .env by setup.sh, which fills every CHANGE_ME with a random value.
# Keep .env private (chmod 600). Never commit it.
# Passwords use letters, digits, "." and "-" only, so they're safe in .env,
# YAML and JSON. The API password must contain upper, lower, digit and symbol.

# Indexer "admin" user (also used by the manager's Filebeat and the dashboard)
INDEXER_PASSWORD=CHANGE_ME
# Indexer "kibanaserver" user (dashboard backend)
DASHBOARD_PASSWORD=CHANGE_ME
# Wazuh API user "wazuh-wui"
API_PASSWORD=CHANGE_ME

# Host bridge address (docker0). Agent and reverse proxy reach the SIEM here.
# setup.sh detects it; 172.17.0.1 is Docker's default.
HOST_BIND_IP=172.17.0.1
DASHBOARD_PORT=5601

# Indexer JVM heap. 1g suits an 8 GB VPS that also runs Nextcloud.
INDEXER_HEAP=1g
