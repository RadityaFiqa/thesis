{
  "$comment": "Index pattern over the filtered alias nextcloud-activity (decision 0009). setup.sh builds it: 'fields' is the only field list the dashboard shows (types come from the indexer), 'hide' are source filters that keep raw Wazuh/Nextcloud fields out of the document view. The full raw alert stays available through the wazuh-alerts-* pattern.",
  "id": "nextcloud-activity",
  "title": "nextcloud-activity",
  "timeFieldName": "timestamp",
  "fields": [
    "timestamp",
    "thesis.user",
    "thesis.action",
    "thesis.outcome",
    "thesis.resource",
    "thesis.client_ip",
    "GeoLocation.country_name",
    "GeoLocation.region_name",
    "GeoLocation.city_name",
    "GeoLocation.location",
    "thesis.sim_time",
    "thesis.http_status",
    "thesis.source",
    "thesis.user_agent",
    "rule.description",
    "rule.level",
    "agent.name",
    "_id",
    "_index",
    "_source"
  ],
  "hide": [
    "data.*",
    "full_log",
    "decoder.*",
    "predecoder.*",
    "input.*",
    "manager.*",
    "location",
    "id",
    "agent.id",
    "agent.ip",
    "rule.groups",
    "rule.id",
    "rule.firedtimes",
    "rule.mail",
    "rule.pci_dss",
    "rule.gdpr",
    "rule.hipaa",
    "rule.nist_800_53",
    "rule.tsc",
    "rule.gpg13",
    "rule.mitre*",
    "GeoLocation.location",
    "thesis.view"
  ]
}
